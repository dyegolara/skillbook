# software-factory chain — environment pins.
#
# Every pin resolves from the environment; an unset variable falls back to its
# default below, so an unset environment runs the chain with today's pins. The
# single source of those defaults is
# skills/software-factory/scripts/env-defaults.mjs — change a default there,
# not here.
#
# Provider-environment pattern: each docker sets DEV_ENV_PROVIDER and that
# provider's own key variable, carrying its own account for that provider. The
# key variable must be set and non-empty after trim; a missing key is a hard
# error naming the provider and the variable to set. There is no generic key
# variable and no fallback chain. Nothing is injected into the launch: the
# environment carries the key, already paired with the resolved provider.
#
# An off-list provider, effort or agent value is a hard error naming the
# variable and listing the allowed values (PROVIDERS, EFFORTS, AGENTS in
# env-defaults.mjs). The model is a free non-empty string.
#
# Set these in the docker's environment; never commit a real key.

# ---- Per-docker account (DEV_ENV_PROVIDER + that provider's own key) ----
#
# Commented, so sourcing this file untouched sets no key. Uncomment both lines
# and fill in this docker's account for the provider.

# Provider every stage runs on. Default: opencode-go.
# DEV_ENV_PROVIDER=opencode-go

# The key: the resolved provider's own variable, set and non-empty after trim.
# The default provider is opencode-go, so its key variable is
# OPENCODE_GO_API_KEY. Fill in this docker's account.
# OPENCODE_GO_API_KEY=

# The other providers' key variables follow the same pattern — uncomment the
# one matching DEV_ENV_PROVIDER instead:
# OPENROUTER_API_KEY=
# OPENAI_API_KEY=
# XAI_API_KEY=
# ANTHROPIC_API_KEY=

# ---- Per-stage pins (defaults from env-defaults.mjs) ----

# GRILL — grill-with-spec (interactive Kepler session).
DEV_ENV_MODEL_GRILL=opencode-go/glm-5.3
DEV_ENV_EFFORT_GRILL=max
DEV_ENV_AGENT_GRILL=opencode

# DEV_FLOW — dev-flow (Kepler terminal).
DEV_ENV_MODEL_DEV_FLOW=opencode-go/glm-5.3
DEV_ENV_EFFORT_DEV_FLOW=max
DEV_ENV_AGENT_DEV_FLOW=pi

# IMPLEMENT_SPEC — implement-spec (Kepler terminal).
DEV_ENV_MODEL_IMPLEMENT_SPEC=opencode-go/deepseek-v4.1-flash
DEV_ENV_EFFORT_IMPLEMENT_SPEC=max
DEV_ENV_AGENT_IMPLEMENT_SPEC=pi

# CODE_REVIEW_LOOP — code-review-loop (Kepler terminal).
DEV_ENV_MODEL_CODE_REVIEW_LOOP=opencode-go/mimo-v2.6-pro
DEV_ENV_EFFORT_CODE_REVIEW_LOOP=high
DEV_ENV_AGENT_CODE_REVIEW_LOOP=pi

# CREATE_PR — create-pr (Kepler terminal).
DEV_ENV_MODEL_CREATE_PR=opencode-go/muse-spark-1.3-contributor
DEV_ENV_EFFORT_CREATE_PR=xhigh
DEV_ENV_AGENT_CREATE_PR=pi
