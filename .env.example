# software-factory chain — environment pins.
#
# Every pin resolves from the environment; an unset variable falls back to its
# default below, so a bare environment runs the chain exactly as it does today.
# The single source of those defaults is
# skills/software-factory/scripts/env-defaults.mjs — change a default there,
# not here.
#
# Per-docker pattern: each docker sets DEV_ENV_PROVIDER and DEV_ENV_API_KEY
# together, with its own account, and leaves the rest at the defaults. With
# neither set — even when the ambient environment carries provider keys — the
# chain keeps the agent's ambient auth: no key is injected and no error fires.
# With either set and no resolvable key, the launch is a hard error naming the
# provider and both variables. The provider-specific key variables at the
# bottom are a manual override only for their own provider — never a global
# fallback.
#
# An off-list provider, effort or agent value is a hard error naming the
# variable and listing the allowed values (PROVIDERS, EFFORTS, AGENTS in
# env-defaults.mjs). The model is a free non-empty string.
#
# Set these in the docker's environment; never commit a real key.

# ---- Per-docker account (each docker sets its own; opt-in pair) ----
#
# These two variables are the opt-in: set them together. Commented, sourcing
# this file leaves both unset, so the chain keeps the agent's ambient auth —
# no key injected, no error. Uncomment both and fill in a real key to run the
# per-docker pattern.

# Provider every stage runs on. Default: opencode-go.
# DEV_ENV_PROVIDER=opencode-go

# This docker's account key. Default: empty; required when the provider needs
# a key and its provider-specific variable (bottom) is not set.
# DEV_ENV_API_KEY=

# ---- Per-stage pins (defaults from env-defaults.mjs) ----

# GRILL — grill-with-spec (interactive Kepler session).
DEV_ENV_MODEL_GRILL=opencode-go/glm-5.3
DEV_ENV_EFFORT_GRILL=max
DEV_ENV_AGENT_GRILL=opencode

# DEV_FLOW — dev-flow (Kepler terminal).
DEV_ENV_MODEL_DEV_FLOW=opencode-go/glm-5.3
DEV_ENV_EFFORT_DEV_FLOW=max
DEV_ENV_AGENT_DEV_FLOW=pi

# IMPLEMENT_SPEC — implement-spec (Kepler terminal).
DEV_ENV_MODEL_IMPLEMENT_SPEC=opencode-go/deepseek-v4.1-flash
DEV_ENV_EFFORT_IMPLEMENT_SPEC=max
DEV_ENV_AGENT_IMPLEMENT_SPEC=pi

# CODE_REVIEW_LOOP — code-review-loop (Kepler terminal).
DEV_ENV_MODEL_CODE_REVIEW_LOOP=opencode-go/mimo-v2.6-pro
DEV_ENV_EFFORT_CODE_REVIEW_LOOP=high
DEV_ENV_AGENT_CODE_REVIEW_LOOP=pi

# CREATE_PR — create-pr (Kepler terminal).
DEV_ENV_MODEL_CREATE_PR=opencode-go/muse-spark-1.3-contributor
DEV_ENV_EFFORT_CREATE_PR=xhigh
DEV_ENV_AGENT_CREATE_PR=pi

# ---- Provider-specific key variables (manual override only) ----
#
# The variable for the provider in DEV_ENV_PROVIDER is tried first; when it is
# set and non-empty it wins over DEV_ENV_API_KEY. Uncomment one only to run a
# docker on a different account than its DEV_ENV_API_KEY.
#
# OPENROUTER_API_KEY=
# OPENCODE_GO_API_KEY=
# OPENAI_API_KEY=
# XAI_API_KEY=
# ANTHROPIC_API_KEY=
